{
  "name": "spore-and-sprawl",
  "version": "0.1.0",
  "private": true,
  "description": "Spore & Sprawl: a lane tug-of-war auto-battler roguelite (Milestone 3: run loop, drafts, relics, carryover).",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite --port 5173",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run tests/unit",
    "test:slow": "vitest run tests/slow",
    "validate:data": "tsx tools/validate-data.ts",
    "sim": "tsx tools/sim.ts",
    "balance": "tsx tools/balance.ts",
    "bench": "tsx --expose-gc tools/bench.ts",
    "golden": "tsx tools/golden.ts",
    "screenshot": "tsx tools/screenshot.ts",
    "verify": "tsx tools/verify.ts"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.5",
    "eslint": "10.13.0",
    "playwright": "1.64.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
